# ra-egress .env — tunnel-provision.ps1 tarafından otomatik oluşturulur.
# Elle oluşturuyorsan aşağıdaki değerleri doldur.
# Bu dosyayı .gitignore'a ekle, asla commit etme.

# Cloudflare Named Tunnel token'ı.
# Kaynak: cloudflared tunnel token <tunnel-adı>
# veya: tunnel-provision.ps1 otomatik yazar.
TUNNEL_TOKEN=

# ra-egress HMAC imza anahtarı — LibEdge proxy Worker ile eşleşmeli.
# Kaynak: setup-staging.ps1 veya admin paneli.
EGRESS_SHARED_SECRET=

# LibEdge API'den dinamik yayıncı host allowlist çekmek için.
# Staging örneği: https://form-handler-staging.agursel.workers.dev
# Production örneği: https://form-handler-prod.agursel.workers.dev
LIBEDGE_API_URL=

# /api/ra/egress/allowed-hosts için servis anahtarı.
# Boş bırakılırsa ALLOWED_HOST_REGEX fallback'i kullanılır.
LIBEDGE_SERVICE_KEY=

# Dinamik host allowlist hangi kurum aboneliklerine göre çekilecek?
# Staging/prod DB'deki institutions.id değeri olmalı.
LIBEDGE_INSTITUTION_ID=

# Publisher hostlarına izin verilen regex (Go syntax).
# Tek kurum, birden fazla publisher olabilir — | ile ayır.
# Geniş fallback: dinamik host listesi alınamazsa bilinen RA yayıncı ailelerini taşır.
ALLOWED_HOST_REGEX=^(([a-z0-9-]+\.)*(jove\.com|acs\.org|annualreviews\.org|webofscience\.com|iop\.org|iopscience\.iop\.org|cas\.org|anatomy\.tv|prod\.anatomy\.tv|emis\.com|els-cdn\.com|wiley\.com|onlinelibrary\.wiley\.com|springer\.com|emerald\.com|emeraldinsight\.com|oup\.com|sciencedirect\.com|nature\.com|nejm\.org|jamanetwork\.com|aacrjournals\.org|ieee\.org|cell\.com|thelancet\.com|sagepub\.com|cambridge\.org|bmj\.com|jstor\.org|projectmuse\.org|proquest\.com|ebsco\.com|ebscohost\.com|clarivate\.com|scopus\.com|knovel\.com|rsc\.org|tandfonline\.com|degruyter\.com|brill\.com|spie\.org|optica\.org|aip\.org|aps\.org|chemrxiv\.org|asme\.org|aiaa\.org|gale\.com|cnki\.net|asha\.org|engineeringvillage\.com)|chemistry\.org|sso\.cas\.org|physicsworld\.com|njp\.org|pubs\.rsc\.org|search\.proquest\.com|search\.ebscohost\.com|link\.springer\.com|academic\.oup\.com|pubs\.acs\.org|doi\.org|dx\.doi\.org|linkinghub\.elsevier\.com|id\.elsevier\.com|www\.elsevier\.com|sciverse-shindig\.elsevier\.com|app\.knovel\.com|adisinsight\.springer\.com|elibrary\.nci\.org\.tr|opac\.tubitak\.gov\.tr|trdizin\.gov\.tr|dergipark\.org\.tr)$
